--!strict
-- Every runway theme. Each round, the lobby votes between three of them
-- (shared/ThemePicker). Tags say which wardrobe pieces fit the theme, Colors
-- which palette colours do, and Words which words in a Roblox catalog item's
-- name do; the judges (shared/Judge) score a look on all three.
--
-- A theme with a Window only turns up between those dates each year, so the
-- seasonal ones drip in by themselves: From and To are { month, day } and a
-- window may wrap past New Year. New themes can be added at the bottom at any
-- time; ids must never change, because saves count wins per theme.

export type Theme = {
	Id: string,
	Name: string,
	Hint: string,
	Tags: { string },
	Colors: { string },
	Words: { string },
	Window: { From: { number }, To: { number } }?,
}

