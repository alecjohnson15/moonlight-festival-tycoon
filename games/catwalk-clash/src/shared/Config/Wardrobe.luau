--!strict
-- The Studio wardrobe: every piece the game builds itself from parts, so the
-- whole collection is original and needs no uploads. shared/Build/Pieces turns
-- a piece into an Accessory; players recolour it with a main colour, an accent
-- colour and a finish (Config/Palette).
--
-- A piece is free (Price 0), costs Sparkles (Price > 0), comes with a game
-- pass (Pass, an id in Config/Catalog) or with a Style Pass tier (Season).
-- Tags say which themes it suits (Config/Themes); no piece is better than
-- another for the judges except by fitting the theme.
--
-- Shapes are placed relative to the body attachment the piece hangs from
-- (Attach), in studs, with the character facing -Z. Each shape is
-- { kind, s = size, p = position, r = rotation in degrees, c = paint,
-- m = finish, t = transparency }, where kind is:
--   Block, Ball, Wedge  plain parts of that shape and size
--   Egg                 an ellipsoid of size s
--   Cyl                 a cylinder along X: s = { length, diameter, diameter }
--   Disc                an upright cylinder: rad = radius, h = height
--   Cone                upright stacked discs from radius rad at the bottom
--                       to top at the top, h tall, in n steps
--   Ring                n beads of size s on a circle of radius rad around Y,
--                       optionally only across arc = { fromDegrees, toDegrees }
--                       measured from the front
-- c is "Main", "Accent" or a palette colour name; m is a finish name, and
-- leaving it out uses the player's chosen finish for Main paint and Satin
-- for everything else.

export type Shape = { [any]: any }

export type Piece = {
	Id: string,
	Name: string,
	Slot: string,
	Tags: { string },
	Price: number,
	Pass: string?,
	Season: number?,
	Main: string,
	Accent: string,
	Finish: string,
	Attach: string?,
	Pair: boolean?,
	Shapes: { Shape },
	Effects: { { [string]: any } }?,
	Light: { [string]: any }?,
	Label: string?,
}

