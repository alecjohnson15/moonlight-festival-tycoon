local byId: { [string]: Piece } = {}
for _, piece in Wardrobe.Pieces do
	byId[piece.Id] = piece
end

function Wardrobe.get(id: string): Piece?
	return byId[id]
end

-- The pieces in a slot, in list order.
function Wardrobe.inSlot(slot: string): { Piece }
	local list = {}
	for _, piece in Wardrobe.Pieces do
		if piece.Slot == slot then
			table.insert(list, piece)
		end
	end
	return list
end

-- The attachment a piece hangs from.
function Wardrobe.attachmentFor(piece: Piece): string
	return piece.Attach or Wardrobe.Attach[piece.Slot]
end

-- How a player can get a piece: "Free", "Sparkles", "Pass" or "Season".
function Wardrobe.source(piece: Piece): string
	if piece.Pass then
		return "Pass"
	elseif piece.Season then
		return "Season"
	elseif piece.Price > 0 then
		return "Sparkles"
	end
	return "Free"
end

return Wardrobe
