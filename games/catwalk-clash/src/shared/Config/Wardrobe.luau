-- A hair cap that covers the top and back of the head.
local function cap(extra: { Shape }): { Shape }
	local shapes: { Shape } = {
		{ "Egg", s = { 1.42, 0.86, 1.42 }, p = { 0, -0.24, 0.06 } },
		{ "Egg", s = { 1.38, 1.0, 0.7 }, p = { 0, -0.62, 0.36 } },
	}
	for _, shape in extra do
		table.insert(shapes, shape)
	end
	return shapes
end

-- A pair of wings on the back, mirrored left and right.
local function wings(size: { number }, x: number, y: number, tilt: number, spread: number, paint: string, finish: string?, t: number?): { Shape }
	return {
		{ "Egg", s = size, p = { -x, y, 0.45 }, r = { 0, -spread, tilt }, c = paint, m = finish, t = t },
		{ "Egg", s = size, p = { x, y, 0.45 }, r = { 0, spread, -tilt }, c = paint, m = finish, t = t },
	}
end

local function join(...: { Shape }): { Shape }
	local all: { Shape } = {}
	for _, list in { ... } do
		for _, shape in list do
			table.insert(all, shape)
		end
	end
	return all
end

